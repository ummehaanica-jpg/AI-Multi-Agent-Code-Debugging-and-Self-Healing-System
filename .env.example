# AI Multi-Agent Code Debugger — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# Optional: OpenAI API key for LLM-assisted repair and explanation
# If not provided, the system runs entirely on rule-based repair.
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Maximum seconds before code execution is killed (default: 5)
# EXECUTION_TIMEOUT=5
